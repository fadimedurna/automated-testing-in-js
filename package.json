{
  "name": "automated-testing-in-js",
  "version": "1.0.0",
  "description": "Defense tasks for JavaScript automated testing program in EPAM Campus",
  "main": "index.js",
  "scripts": {
    "test": "mocha --reporter mochawesome",
    "coverage": "c8 --all --include=src/NumbersValidator.js --check-coverage --lines 100 --functions 100 --branches 100 --statements 100 --reporter=text --reporter=html mocha --reporter mochawesome",
    "lint": "eslint src test"
  },
  "keywords": [
    "javascript",
    "automated-testing",
    "unit-tests",
    "ui-tests",
    "api-tests"
  ],
  "author": "Fadime Durna",
  "license": "ISC",
  "private": true,
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "mocha": "^12.0.3",
    "mochawesome": "^8.1.1"
  }
}